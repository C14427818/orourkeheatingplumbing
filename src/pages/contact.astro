---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { PHONE_TEL, PHONE_DISPLAY, WHATSAPP_URL, EMAIL, SITE_NAME, withBase } from '../lib/site';
---
<BaseLayout
  title="Contact"
  description="Call, WhatsApp or send a message to O'Rourke Heating & Plumbing in Dublin."
>
  <section class="section-pad bg-navy text-white" aria-labelledby="contact-heading">
    <div class="container-narrow">
      <h1 id="contact-heading" class="font-display text-4xl font-semibold text-white sm:text-5xl">Contact us</h1>
      <p class="mt-3 max-w-2xl text-lg text-white/85">
        Tell us what is going on — we will get back to you as soon as we can.
      </p>

      <figure class="mt-8 overflow-hidden rounded-2xl shadow-lg ring-1 ring-white/10">
        <img
          src={withBase('contact-promo.webp')}
          width="1254"
          height="1254"
          alt={`${SITE_NAME} — heating homes and keeping Ireland flowing; local, reliable plumbing and heating`}
          class="h-auto w-full object-cover object-center"
          decoding="async"
          loading="lazy"
        />
      </figure>

      <div class="mt-10 grid gap-8 lg:grid-cols-5">
        <div class="space-y-4 lg:col-span-2">
          <a
            href={`tel:${PHONE_TEL}`}
            class="flex min-h-[64px] items-center justify-center gap-3 rounded-2xl bg-copper px-6 py-5 text-center text-xl font-semibold text-white shadow-sm transition hover:bg-copper-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            <span aria-hidden="true">📞</span>
            Call {PHONE_DISPLAY}
          </a>

          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline-light flex min-h-[56px] w-full items-center justify-center gap-3 rounded-2xl px-6 py-4 text-center text-lg"
          >
            <span aria-hidden="true">💬</span>
            Message on WhatsApp
          </a>

          <a
            href={`mailto:${EMAIL}`}
            class="flex min-h-[48px] items-center justify-center rounded-2xl border-2 border-white/25 bg-white/5 px-6 py-3 text-center font-semibold text-white transition hover:border-copper-light hover:bg-white/10"
          >
            {EMAIL}
          </a>

          <div class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/15">
            <h2 class="font-display text-lg font-semibold text-white">Hours</h2>
            <p class="mt-2 text-sm text-white/80">
              <!-- TODO PLACEHOLDER hours -->
              Weekdays: 8:00–18:00
            </p>
            <p class="mt-2 text-sm text-white/80">
              Emergencies: message or call and we will say if we can help the same day. We do not claim 24/7 nationwide cover.
            </p>
          </div>
        </div>

        <div class="lg:col-span-3">
          <h2 class="mb-4 font-display text-2xl font-semibold text-white">Send a message</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
