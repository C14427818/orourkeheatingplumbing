---
import { EMAIL } from '../lib/site';
---
<div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-navy/10 sm:p-8" data-contact-form>
  <p class="mb-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900 ring-1 ring-amber-200">
    <strong>DEMO form.</strong> This does not send to a server. On submit it opens your email client (mailto) or shows a local success message.
  </p>

  <form id="contact-form" class="space-y-5" novalidate>
    <div>
      <label for="name" class="block text-sm font-semibold text-navy">Name</label>
      <input type="text" id="name" name="name" required autocomplete="name"
        class="mt-1.5 w-full rounded-lg border border-navy/15 bg-white px-3 py-2.5 text-charcoal shadow-sm focus:border-copper focus:ring-2 focus:ring-copper/30" />
    </div>
    <div>
      <label for="phone" class="block text-sm font-semibold text-navy">Phone</label>
      <input type="tel" id="phone" name="phone" required autocomplete="tel"
        class="mt-1.5 w-full rounded-lg border border-navy/15 bg-white px-3 py-2.5 text-charcoal shadow-sm focus:border-copper focus:ring-2 focus:ring-copper/30" />
    </div>
    <div>
      <label for="location" class="block text-sm font-semibold text-navy">Eircode / town</label>
      <input type="text" id="location" name="location" required autocomplete="postal-code"
        class="mt-1.5 w-full rounded-lg border border-navy/15 bg-white px-3 py-2.5 text-charcoal shadow-sm focus:border-copper focus:ring-2 focus:ring-copper/30" />
    </div>
    <div>
      <label for="jobType" class="block text-sm font-semibold text-navy">Job type</label>
      <select id="jobType" name="jobType" required
        class="mt-1.5 w-full rounded-lg border border-navy/15 bg-white px-3 py-2.5 text-charcoal shadow-sm focus:border-copper focus:ring-2 focus:ring-copper/30">
        <option value="">Select…</option>
        <option>Emergency plumbing</option>
        <option>Blocked drains</option>
        <option>Boilers &amp; heating</option>
        <option>Burst pipes / leaks</option>
        <option>Bathrooms</option>
        <option>Immersion &amp; hot water</option>
        <option>Other</option>
      </select>
    </div>
    <div>
      <label for="message" class="block text-sm font-semibold text-navy">Message</label>
      <textarea id="message" name="message" rows="4" required
        class="mt-1.5 w-full rounded-lg border border-navy/15 bg-white px-3 py-2.5 text-charcoal shadow-sm focus:border-copper focus:ring-2 focus:ring-copper/30"></textarea>
    </div>
    <div class="flex flex-wrap gap-3">
      <button type="submit" class="btn-copper">Open email (mailto DEMO)</button>
      <button type="button" class="btn-navy" data-demo-success>Show success state (DEMO)</button>
    </div>
  </form>

  <div id="form-success" class="mt-6 hidden rounded-xl bg-emerald-50 p-5 text-emerald-900 ring-1 ring-emerald-200" role="status" aria-live="polite">
    <p class="font-semibold">DEMO — message not sent</p>
    <p class="mt-1 text-sm">In production this would go to a real inbox or booking system. Your details stayed in the browser only.</p>
    <button type="button" class="mt-3 text-sm font-semibold underline" data-reset-form>Reset form</button>
  </div>
</div>

<script define:vars={{ EMAIL }}>
  const emailTo = EMAIL;
  const root = document.querySelector('[data-contact-form]');
  if (root) {
    const form = root.querySelector('#contact-form');
    const success = root.querySelector('#form-success');
    const demoBtn = root.querySelector('[data-demo-success]');
    const resetBtn = root.querySelector('[data-reset-form]');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = new FormData(form);
      const body = [
        `Name: ${data.get('name')}`,
        `Phone: ${data.get('phone')}`,
        `Eircode/town: ${data.get('location')}`,
        `Job type: ${data.get('jobType')}`,
        '',
        String(data.get('message') || ''),
      ].join('\n');
      const subject = encodeURIComponent(`Job enquiry — ${data.get('jobType')}`);
      const mailto = `mailto:${emailTo}?subject=${subject}&body=${encodeURIComponent(body)}`;
      window.location.href = mailto;
    });

    demoBtn?.addEventListener('click', () => {
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      form.classList.add('hidden');
      success?.classList.remove('hidden');
    });

    resetBtn?.addEventListener('click', () => {
      if (!(form instanceof HTMLFormElement)) return;
      form.reset();
      form.classList.remove('hidden');
      success?.classList.add('hidden');
    });
  }
</script>
