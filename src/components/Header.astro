---
import { SITE_NAME, withBase, PHONE_TEL, PHONE_DISPLAY, WHATSAPP_URL } from '../lib/site';
const pathname = Astro.url.pathname;
const homeHref = withBase('');
const contactHref = withBase('contact/');
const isHome = pathname === homeHref || pathname === withBase('index.html') || pathname.endsWith('/orourkeheatingplumbing') || pathname.endsWith('/orourkeheatingplumbing/');
const markSrc = withBase('logo-mark.webp');
---
<header class="sticky top-0 z-40 border-b border-white/10 bg-navy text-white">
  <div class="container-narrow flex items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a
      href={homeHref}
      class="group flex min-h-[44px] items-center gap-2.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-copper sm:gap-3"
      aria-label={SITE_NAME}
    >
      <img
        src={markSrc}
        width="168"
        height="168"
        alt=""
        class="h-10 w-10 shrink-0 object-contain sm:h-11 sm:w-11"
        decoding="async"
      />
      <span class="flex flex-col leading-none">
        <span class="font-display text-lg font-semibold tracking-tight text-white sm:text-xl">O&apos;Rourke</span>
        <span class="mt-0.5 text-[10px] font-bold uppercase tracking-[0.12em] sm:text-[11px]">
          <span class="text-copper-light">HEATING</span>
          <span class="text-white">&amp;</span>
          <span class="text-water">PLUMBING</span>
        </span>
      </span>
    </a>
    <nav class="hidden items-center gap-6 sm:flex" aria-label="Primary">
      <a
        href={homeHref}
        class:list={["text-sm font-medium hover:text-copper-light transition", isHome && "text-copper-light"]}
      >Home</a>
      <a
        href={contactHref}
        class:list={["text-sm font-medium hover:text-copper-light transition", pathname.includes('/contact') && "text-copper-light"]}
      >Contact</a>
      <a href={`tel:${PHONE_TEL}`} class="btn-copper !py-2 !px-4 text-sm">{PHONE_DISPLAY}</a>
      <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn-outline-light !py-2 !px-4 text-sm">WhatsApp</a>
    </nav>
    <a href={contactHref} class="btn-copper !py-2 !px-4 text-sm sm:hidden">Contact</a>
  </div>
</header>
